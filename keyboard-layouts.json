{
  "$comment": [
    "Keyboard configuration. Two independent axes:",
    "  platforms — which physical modifier is the 'primary' shortcut key.",
    "  layouts   — which key combination produces each character, and how we NAME it.",
    "",
    "DETECTION vs DISPLAY — read this before changing anything:",
    "  Characters are DETECTED via KeyboardEvent.key. The browser/OS has already",
    "  applied the user's layout by then, so '@' is '@' on every layout and the",
    "  game works out of the box anywhere. The layout entries below exist to",
    "  DISPLAY the right combination: hints, reverse-recall prompts and the final",
    "  answer reveal. Tell a Spanish-layout student 'Shift + 2' and you have",
    "  taught them something false, which is the whole reason this file exists.",
    "  Shortcuts are DETECTED via KeyboardEvent.code + the platform primary",
    "  modifier, because Ctrl+C must stay Ctrl+C regardless of the letter layout."
  ],
  "defaultPlatform": "windows",
  "defaultLayout": "us",
  "platforms": {
    "windows": {
      "name": "Windows / Linux",
      "primaryModifier": "ctrlKey",
      "primaryLabel": "Ctrl"
    },
    "mac": {
      "name": "macOS",
      "primaryModifier": "metaKey",
      "primaryLabel": "Cmd"
    }
  },
  "modifierLabels": {
    "Shift": "Shift",
    "AltGr": "AltGr",
    "Primary": "{primary}"
  },
  "keyRegions": {
    "numberRow": "the number row, along the top",
    "rightOfLetters": "the keys to the right of the letters",
    "bottomRow": "the bottom row, near the space bar",
    "topLeft": "the top-left corner of the keyboard",
    "letters": "the letter keys"
  },
