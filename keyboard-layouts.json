{
  "$comment": [
    "Keyboard configuration. Two independent axes:",
    "  platforms — which physical modifier is the 'primary' shortcut key.",
    "  layouts   — which key combination produces each character, and how we NAME it.",
    "",
    "DETECTION vs DISPLAY — read this before changing anything:",
    "  Characters are DETECTED via KeyboardEvent.key. The browser/OS has already",
    "  applied the user's layout by then, so '@' is '@' on every layout and the",
    "  game works out of the box anywhere. The layout entries below exist to",
    "  DISPLAY the right combination: hints, reverse-recall prompts and the final",
    "  answer reveal. Tell a Spanish-layout student 'Shift + 2' and you have",
    "  taught them something false, which is the whole reason this file exists.",
    "  Shortcuts are DETECTED via KeyboardEvent.code + the platform primary",
    "  modifier, because Ctrl+C must stay Ctrl+C regardless of the letter layout."
  ],

  "defaultPlatform": "windows",
  "defaultLayout": "us",

  "platforms": {
    "windows": {
      "name": "Windows / Linux",
      "primaryModifier": "ctrlKey",
      "primaryLabel": "Ctrl"
    },
    "mac": {
      "name": "macOS",
      "primaryModifier": "metaKey",
      "primaryLabel": "Cmd"
    }
  },

  "modifierLabels": {
    "Shift": "Shift",
    "AltGr": "AltGr",
    "Primary": "{primary}"
  },

  "keyRegions": {
    "numberRow": "the number row, along the top",
    "rightOfLetters": "the keys to the right of the letters",
    "bottomRow": "the bottom row, near the space bar",
    "topLeft": "the top-left corner of the keyboard",
    "letters": "the letter keys"
  },

  "layouts": {
    "us": {
      "name": "US QWERTY",
      "status": "complete",
      "characters": {
        "!": { "modifiers": ["Shift"], "baseKey": "1",  "region": "numberRow" },
        "@": { "modifiers": ["Shift"], "baseKey": "2",  "region": "numberRow" },
        "#": { "modifiers": ["Shift"], "baseKey": "3",  "region": "numberRow" },
        "$": { "modifiers": ["Shift"], "baseKey": "4",  "region": "numberRow" },
        "%": { "modifiers": ["Shift"], "baseKey": "5",  "region": "numberRow" },
        "^": { "modifiers": ["Shift"], "baseKey": "6",  "region": "numberRow" },
        "&": { "modifiers": ["Shift"], "baseKey": "7",  "region": "numberRow" },
        "*": { "modifiers": ["Shift"], "baseKey": "8",  "region": "numberRow" },
        "(": { "modifiers": ["Shift"], "baseKey": "9",  "region": "numberRow" },
        ")": { "modifiers": ["Shift"], "baseKey": "0",  "region": "numberRow" },
        "_": { "modifiers": ["Shift"], "baseKey": "-",  "region": "numberRow" },
        "+": { "modifiers": ["Shift"], "baseKey": "=",  "region": "numberRow" },
        "?": { "modifiers": ["Shift"], "baseKey": "/",  "region": "bottomRow" },
        ":": { "modifiers": ["Shift"], "baseKey": ";",  "region": "rightOfLetters" },
        "\"": { "modifiers": ["Shift"], "baseKey": "'", "region": "rightOfLetters" },
        "<": { "modifiers": ["Shift"], "baseKey": ",",  "region": "bottomRow" },
        ">": { "modifiers": ["Shift"], "baseKey": ".",  "region": "bottomRow" },
        "{": { "modifiers": ["Shift"], "baseKey": "[",  "region": "rightOfLetters" },
        "}": { "modifiers": ["Shift"], "baseKey": "]",  "region": "rightOfLetters" },
        "|": { "modifiers": ["Shift"], "baseKey": "\\", "region": "rightOfLetters" },
        "~": { "modifiers": ["Shift"], "baseKey": "`",  "region": "topLeft" }
      }
    },

    "es-la": {
      "name": "Spanish (Latin America) QWERTY",
      "status": "partial",
      "$comment": [
        "Only bindings verified as differing-or-matching with confidence are listed.",
        "Characters absent here are unsupported for DISPLAY on this layout: the",
        "curriculum builder refuses to emit a challenge it cannot name correctly,",
        "rather than showing a student the US combination and calling it the truth.",
        "Add entries after confirming on the actual classroom hardware."
      ],
      "characters": {
        "!": { "modifiers": ["Shift"], "baseKey": "1", "region": "numberRow" },
        "\"": { "modifiers": ["Shift"], "baseKey": "2", "region": "numberRow" },
        "#": { "modifiers": ["Shift"], "baseKey": "3", "region": "numberRow" },
        "$": { "modifiers": ["Shift"], "baseKey": "4", "region": "numberRow" },
        "%": { "modifiers": ["Shift"], "baseKey": "5", "region": "numberRow" },
        "&": { "modifiers": ["Shift"], "baseKey": "6", "region": "numberRow" },
        "/": { "modifiers": ["Shift"], "baseKey": "7", "region": "numberRow" },
        "(": { "modifiers": ["Shift"], "baseKey": "8", "region": "numberRow" },
        ")": { "modifiers": ["Shift"], "baseKey": "9", "region": "numberRow" },
        "=": { "modifiers": ["Shift"], "baseKey": "0", "region": "numberRow" },
        "@": { "modifiers": ["AltGr"], "baseKey": "Q", "region": "letters" }
      }
    }
  },

  "shortcuts": {
    "COPY":       { "modifiers": ["Primary"], "baseKey": "C", "code": "KeyC", "region": "bottomRow", "difficulty": 1 },
    "PASTE":      { "modifiers": ["Primary"], "baseKey": "V", "code": "KeyV", "region": "bottomRow", "difficulty": 1 },
    "CUT":        { "modifiers": ["Primary"], "baseKey": "X", "code": "KeyX", "region": "bottomRow", "difficulty": 2 },
    "UNDO":       { "modifiers": ["Primary"], "baseKey": "Z", "code": "KeyZ", "region": "bottomRow", "difficulty": 2 },
    "SELECT ALL": { "modifiers": ["Primary"], "baseKey": "A", "code": "KeyA", "region": "letters",   "difficulty": 2 },
    "SAVE":       { "modifiers": ["Primary"], "baseKey": "S", "code": "KeyS", "region": "letters",   "difficulty": 3 },
    "BOLD":       { "modifiers": ["Primary"], "baseKey": "B", "code": "KeyB", "region": "bottomRow", "difficulty": 3 },
    "FIND":       { "modifiers": ["Primary"], "baseKey": "F", "code": "KeyF", "region": "letters",   "difficulty": 4 },
    "REDO":       { "modifiers": ["Primary"], "baseKey": "Y", "code": "KeyY", "region": "letters",   "difficulty": 4 }
  },

  "characterDifficulty": {
    "1": ["!", "@", "#", "$", "%"],
    "2": ["^", "&", "*", "(", ")"],
    "3": ["?", ":", "\"", "_", "+"],
    "4": ["<", ">", "{", "}", "|", "~"]
  }
}
